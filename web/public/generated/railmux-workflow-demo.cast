it returns \u001b[38;5;179mCOMPACT\u001b[38;5;252m even though 30 rows clear the height gate.\u001b[39m\u001b[K\u001b[38;5;252m\u001b[15;49H  160x38: 160 ≥ 80 and 38 ≥ 24, so it stays \u001b[38;5;179mWIDE\u001b[38;5;252m with sidebar plus agent. COMPACT_EXIT_WIDTH/HEIGHT (84/26)\u001b[39m\u001b[K\u001b[38;5;252m\u001b[16;49H  only applies once already compact.\u001b[39m\u001b[K\u001b[38;5;252m\u001b[17;49H  Existing focused test:\u001b[39m\u001b[K\u001b[38;5;252m\u001b[18;49H  \u001b[38;5;114mtests/test_agent_workspace.py::test_compact_presentation_uses_two_dimensional_hysteresis\u001b[38;5;252m pins both width and\u001b[39m\u001b[K\u001b[38;5;252m\u001b[19;49H  height behavior.\u001b[39m\u001b[K\u001b[38;5;252m\u001b[20;49H  Recorder guard: pass each non-mobile profile through presentation_for_geometry and assert\u001b[39m\u001b[K\u001b[38;5;252m\u001b[21;49H  \u001b[38;5;110mWorkspacePresentation.WIDE\u001b[38;5;252m.\u001b[39m\u001b[K\u001b[22;49H\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\u001b[38;5;239m\n───────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\u001b[K\u001b[38;5;147m\u001b[35;49H❯\u001b[39m \u001b[K\u001b[38;5;239m\u001b[36;49H───────────────────────────────────────────────"]
