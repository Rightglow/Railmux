[8.719039, "o", "52m\u001b[48;5;236m Help\u001b[49m\u001b[38;5;244m \u001b[38;5;231m\u001b[48;5;236m\u001b[1mq\u001b(B\u001b[m\u001b[38;5;252m\u001b[48;5;236m Quit\u001b[49m\u001b[38;5;244m \u001b[38;5;231m\u001b[48;5;236m\u001b[1mC-b d\u001b(B\u001b[m\u001b[38;5;252m\u001b[48;5;236m Detach\u001b[49m\u001b[38;5;244m \u001b[38;5;231m\u001b[48;5;236m\u001b[1m+\u001b(B\u001b[m\u001b[38;5;252m\u001b[48;5;236m More\u001b[49m\u001b[1;49H  accidentally using compact mode.\u001b[39m\u001b[K\u001b[2;49H\u001b[K\u001b[38;5;147m\n●\u001b[39m \u001b[38;5;252m\u001b[1mVerify responsive layout gates\u001b(B\u001b[m\u001b[K\u001b[38;5;252m\u001b[1m\u001b[4;49H  \u001b(B\u001b[m\u001b[38;5;110mpresentation_for_geometry()\u001b[38;5;252m selects the projection from geometry with hysteresis.\u001b[39m\u001b[K\u001b[38;5;252m\u001b[5;49H  From \u001b[38;5;110mWorkspacePresentation.WIDE\u001b[38;5;252m it enters \u001b[38;5;179mCOMPACT\u001b[38;5;252m when either dimension is cramped: width < COMPACT_ENTER_WIDT\u001b[6;49HH (80) or height < COMPACT_ENTER_HEIGHT (24).\u001b[39m\u001b[K\u001b[38;5;252m\u001b[7;49H  76x30: width 76 < 80, so it returns \u001b[38;5;179mCOMPACT\u001b[38;5;252m even though 30 rows clear the height gate.\u001b[39m\u001b[K\u001b[38;5;252m\u001b[8;49H  160x38: 160 ≥ 80 and 38 ≥ 24, so it stays \u001b[38;5;179mWIDE\u001b[38;5;252m with sidebar plus agent. COMPACT_EXIT_WIDTH/HEIGHT (84/26) only\u001b[9;49H applies once already compact.\u001b[39m\u001b[K\u001b[38;5;252m\u001b[10;49H  Existing focused test: \u001b[38;5;114mtests/test_agent_workspace.py::test_compact_presentation_uses_two_dimensional_hysteresi\u001b[11;49Hs\u001b[38;5;252m pins both width and height behavior.\u001b[39m\u001b[K\u001b[38;5;252m\u001b[12;49H  Recorder guard: pass each non-mobile profile through presentation_for_geometry and assert \u001b[38;5;110mWorkspacePresentatio\u001b[13;49Hn.WIDE\u001b[38;5;252m.\u001b[39m\u001b[K\u001b[14;49H\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\u001b[38;5;239m\n────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[33;49H───────────────────────────────────────────────\u001b[39m\u001b[K\u001b[38;5;147m\u001b[34;49H❯\u001b[39m \u001b[K\u001b[38;5;239m\u001b[35;49H─────────────────────────────────────────────────────────────────────────────────────────────"]
