1X\r\n\u001b[38;5;252m                                         \u001b[39m\u001b[1X\r\n\u001b[38;5;252m                                         \u001b[39m\u001b[1X\r\n\u001b[38;5;252m                                         \u001b[39m\u001b[1X\r\n\u001b[38;5;252m                                         \u001b[39m\u001b[1X\r\n\u001b[38;5;252m                                         \u001b[39m\u001b[1X\r\n\u001b[38;5;252m                                         \u001b[39m\u001b[1X\r\n\u001b[38;5;252m                                         \u001b[39m\u001b[1X\r\n\u001b[38;5;252m                                         \u001b[39m\u001b[1X\r\n\u001b[30m\u001b[1m─ RUNNING ─────────────────────────── 1 ─\u001b(B\u001b[m\u001b[1X\r\n\u001b[38;5;70m\u001b[48;5;237m\u001b[1m•\u001b[38;5;231m railmux/(new)                          \u001b(B\u001b[m\u001b[1X\r\n\u001b[38;5;252m                                         \u001b[39m\u001b[1X\r\n\u001b[38;5;252m                                         \u001b[39m\u001b[1X\r\n\u001b[38;5;252m                                         \u001b[39m\u001b[1X\r\n\u001b[38;5;252m                                         \u001b[39m\u001b[1X\r\n\u001b[38;5;252m                                         \u001b[39m\u001b[1X\r\n\u001b[38;5;252m                                         \u001b[39m\u001b[1X\r\n\u001b[38;5;252m                                         \u001b[39m\u001b[1X\r\n\u001b[30m\u001b[1m─────────────────────────────────────────\u001b(B\u001b[m\u001b[1X\r\n\u001b[30m\u001b[1mF8 layout · F9 fullscreen\u001b(B\u001b[m\u001b[17X\r\n\u001b[30m\u001b[1mC-b Tab/← Sidebar · C-b → Pane 2\u001b(B\u001b[m\u001b[10X\r\n\u001b[38;5;231m\u001b[48;5;236m\u001b[1m?\u001b(B\u001b[m\u001b[38;5;252m\u001b[48;5;236m Help\u001b[49m\u001b[30m\u001b[1m \u001b[38;5;231m\u001b[48;5;236mq\u001b(B\u001b[m\u001b[38;5;252m\u001b[48;5;236m Quit\u001b[49m\u001b[30m\u001b[1m \u001b[38;5;231m\u001b[48;5;236mC-b d\u001b(B\u001b[m\u001b[38;5;252m\u001b[48;5;236m Detach\u