u001b[39m\u001b[70X\u001b[38;5;252m\u001b[14;44H  From \u001b[38;5;110mWorkspacePresentation.WIDE\u001b[38;5;252m it enters \u001b[38;5;179mCOMPACT\u001b[38;5;252m when either dimension is\u001b[39m\u001b[7X\u001b[38;5;252m\u001b[15;44H  cramped: width < COMPACT_ENTER_WIDTH (80) or height < COMPACT_ENTER_HEIGHT (24).\u001b[39m\u001b[1X\u001b[38;5;252m\u001b[16;44H  76x30: width 76 < 80, so it returns \u001b[38;5;179mCOMPACT\u001b[38;5;252m even though 30 rows clear the height\u001b[39m\u001b[1X\u001b[38;5;252m\u001b[17;44H  gate.\u001b[39m\u001b[76X\u001b[38;5;252m\u001b[18;44H  160x38: 160 ≥ 80 and 38 ≥ 24, so it stays \u001b[38;5;179mWIDE\u001b[38;5;252m with sidebar plus agent.\u001b[39m\u001b[10X\u001b[38;5;252m\u001b[19;44H  COMPACT_EXIT_WIDTH/HEIGHT (84/26) only applies once already compact.\u001b[39m\u001b[13X\u001b[38;5;252m\u001b[20;44H  Existing focused test: \u001b[38;5;114mtests/test_agent_workspace.py::test_compact_presentation_\u001b[39m\u001b[1X\u001b[38;5;252m\u001b[21;44H  uses_two_dimensional_hysteresis pins both width and height behavior.\u001b[39m\u001b[13X\u001b[38;5;252m\u001b[22;44H  Recorder guard: pass each non-mobile profile through presentation_for_geometry\u001b[39m\u001b[3X\u001b[38;5;252m\u001b[23;44H  and assert \u001b[38;5;110mWorkspacePresentation.WIDE\u001b[38;5;252m.\u001b[39m\u001b[43X\u001b[24;44H\u001b[83X\n\u001b[83X\n\u001b[83X\n\u001b[83X\n\u001b[83X\n\u001b[83X\n\u001b[83X\n\u001b[83X\n\u001b[83X\n\u001b[83X\n\u001b[83X\n\u001b[83X\n\u001b[83X\n\u001b[83X\u001b[38;5;239m\n──────────────────────────────────────────────────────────────────────────────────\u001b[39m\u001b[1X\u001b[38;5;147m\u001b[39;44H❯\u001b[39m \u001b[81X\u001b[38;5;239m\u001b[40;44H──────────────────────────────────────────────────────────────────────────────────\u001b[39m\u001b[1X\u001b[38;5;244m\u001b[41;44H  ⏵⏵ normal mode · shift+tab to cycle · ← for agents\u001b[39m\u001b[31X\u001b[1;128H\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001