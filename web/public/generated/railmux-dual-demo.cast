 via\u001b(B\u001b[m\u001b[9X\u001b[38;5;252m\u001b[1m\u001b[20;44H  surface.paint_overlays.\u001b(B\u001b[m\u001b[58X\u001b[38;5;252m\u001b[1m\u001b[21;44H  4. This is a fast-client history overlay over bounded snapshots, not tmux copy-\u001b(B\u001b[m\u001b[2X\u001b[38;5;252m\u001b[1m\u001b[22;44H  mode; the implementation notes stock tmux WheelUpPane would enter copy-mode,\u001b(B\u001b[m\u001b[5X\u001b[38;5;252m\u001b[1m\u001b[23;44H  which is deliberately avoided.\u001b(B\u001b[m\u001b[51X\u001b[38;5;252m\u001b[1m\u001b[24;44H  Focused test: tests/test_fast_full_window.py::test_local_history_routes_sidebar_\u001b(B\u001b[m\u001b[1X\u001b[38;5;252m\u001b[1m\u001b[25;44H  immediately_and_owns_agent_wheel asserts agent_action.forwarded_input == b\"\".\u001b(B\u001b[m\u001b[4X\u001b[38;5;252m\u001b[1m\u001b[26;44H  Suggested addition: assert agent_action.render_history is True, proving the\u001b(B\u001b[m\u001b[6X\u001b[38;5;252m\u001b[1m\u001b[27;44H  overlay rendered rather than merely dropping the event.\u001b(B\u001b[m\u001b[26X\u001b[28;44H\u001b[83X\n\u001b[83X\n\u001b[83X\n\u001b[83X\n\u001b[83X\n\u001b[83X\n\u001b[83X\n\u001b[83X\n\u001b[83X\n\u001b[83X\u001b[38;5;239m\u001b[1m\n──────────────────────────────────────────────────────────────────────────────────\u001b(B\u001b[m\u001b[1X\u001b[38;5;147m\u001b[1m\u001b[39;44H❯\u001b(B\u001b[m \u001b[81X\u001b[38;5;239m\u001b[40;44H──────────────────────────────────────────────────────────────────────────────────\u001b[39m\u001b[1X\u001b[38;5;244m\u001b[41;44H  ⏵⏵ normal mode · shift+tab to cycle · ← for agents\u001b[39m\u001b[31X\u001b[1;128H\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n                                \u001b[38;5;70m\u001b[1mRAILMUX  ·  PANE 2\u001b(B\u001b[m\u001b[K\u001b[20;128H                              \u001b[37m\u001b[1mReady for another agent\u001b(B\u00