01b[39m\u001b[K\u001b[38;5;252m\u001b[12;64H  COMPACT_ENTER_HEIGHT (24).\u001b[39m\u001b[K\u001b[38;5;252m\u001b[13;64H  76x30: width 76 < 80, so it returns COMPACT even though 30 rows clear the height gate.\u001b[39m\u001b[K\u001b[38;5;252m\u001b[14;64H  160x38: 160 ≥ 80 and 38 ≥ 24, so it stays WIDE with sidebar plus agent. COMPACT_EXIT_WIDTH/HEIGHT (84/26) only applies once already compact.\u001b[39m\u001b[K\u001b[38;5;252m\u001b[15;64H  Existing focused test: tests/test_agent_workspace.py::test_compact_presentation_uses_two_dimensional_hysteresis pins both width and height\u001b[39m\u001b[K\u001b[38;5;252m\u001b[16;64H  behavior.\u001b[39m\u001b[K\u001b[38;5;252m\u001b[17;64H  Recorder guard: pass each non-mobile profile through presentation_for_geometry and assert WorkspacePresentation.WIDE.\u001b[39m\u001b[K\u001b[18;64H\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\u001b[38;5;239m\n──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\u001b[K\u001b[38;5;147m\u001b[39;64H❯\u001b[39m \u001b[K\u001b[38;5;239m\u001b[40;64H────────────────────────────────────────────────────────────────────────────────────────────"]
