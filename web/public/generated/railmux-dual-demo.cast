38;5;252m\u001b[21;44H  uses_two_dimensional_hysteresis pins both width and height behavior.\u001b[39m\u001b[13X\u001b[38;5;252m\u001b[22;44H  Recorder guard: pass each non-mobile profile through presentation_for_geometry\u001b[39m\u001b[3X\u001b[38;5;252m\u001b[23;44H  and assert \u001b[38;5;110mWorkspacePresentation.WIDE\u001b[38;5;252m.\u001b[39m\u001b[43X\u001b[24;44H\u001b[83X\n\u001b[83X\n\u001b[83X\n\u001b[83X\n\u001b[83X\n\u001b[83X\n\u001b[83X\n\u001b[83X\n\u001b[83X\n\u001b[83X\n\u001b[83X\n\u001b[83X\n\u001b[83X\n\u001b[83X\u001b[38;5;239m\n──────────────────────────────────────────────────────────────────────────────────\u001b[39m\u001b[1X\u001b[38;5;147m\u001b[39;44H❯\u001b[39m \u001b[81X\u001b[38;5;239m\u001b[40;44H────────────────────────────────────────────────────"]
