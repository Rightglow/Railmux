\n+ New session                                        \r\n─────────────────────────────────────────────────────\r\n◦\u001b[38;5;252m Polish SSH history                                 \u001b[38;5;244m\r\n  2d ago · 2 msg · 0 tok\u001b[38;5;252m                             \u001b[38;5;244m\r\n◦\u001b[38;5;252m Review layout policy                               \u001b[38;5;244m\r\n  2d ago · 2 msg · 0 tok\u001b[38;5;252m                             \u001b[38;5;244m\r\n◦\u001b[38;5;252m Add mobile controls                                \u001b[38;5;244m\r\n  2d ago · 2 msg · 0 tok\u001b[38;5;252m                             \r\n                                                     \r\n                                                     \r\n                                                     \r\n                                                     \r\n                                                     \r\n                                                     \r\n                                                     \r\n                                                     \u001b[38;5;244m\r\n─ RUNNING ───────────────────────────────────────────\r\n  (no running Claude Code sessions)\u001b[38;5;252m                  \r\n                                                     \r\n                                                     \r\n                                                     \r\n                                                     \r\n                                                     \r\n                                                     \u001b[38;5;244m\r\n─────────────────────────────────────────────────────\r\n↑↓ move · Tab pane · C-b Tab Target · ↵ open · n new \u001b[39m\u001b[36;53H\u001b[1K\n\u001b[1K\u001b[38;5;231m\u001b[48;5;236m\u001b[1m\r?\u001b(B\u001b[m\u001b[38;5;252m\u001b[48;5;236m Help\u001b[49m\u001b[38;5;244m \u001b[38;5;231m\u001b[48;5;236m\u001b[1mq\u001b(B\u001b[m\u001b[38;5;252m\u001b[48;5;236m Quit\u001b[49m\u001b[38;5;244m \u001b[38;5;231m\u001b[48;5;236m\u001b[1mC-b d\u001b(B\u001b[m\u001b[38;5;252m\u001b[48;5;236m Detach\u001b[49m\u001b[38;5;244m \u001b[38;5;231m\u001b[48;5;236m\u001b[1m+\u001b(B\u001b[m\u001b[38;5;252m\u001b[48;5;236m More\u001b[49m\u001b[1;55H ▐▛███▜▌   Claude Code"]
