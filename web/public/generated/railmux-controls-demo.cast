[8.041285, "o", "\u001b[H\u001b[30m\u001b[1m─ PROJECTS ──────────────────── 1 ─\u001b(B\u001b[m\u001b[1X\u001b[4;1H\u001b[38;5;231m\u001b[48;5;237m\u001b[1m  railmux                        1 \u001b(B\u001b[m\u001b[1X\u001b[9;1H\u001b[30m\u001b[1m─ SESSIONS (railmux) ────────── 1 ─\u001b(B\u001b[m\u001b[1X\u001b[13;1H\u001b[38;5;244m  2\u001b[39m┌─────── Confirm quit ──────┐\u001b[38;5;252m   \u001b[39m\u001b[1X\r\n\u001b[38;5;252m   \u001b[39m│       Quit railmux?       │\u001b[38;5;252m   \u001b[39m\u001b[1X\r\n\u001b[38;5;252m   \u001b[39m│                           │\u001b[38;5;252m   \u001b[39m\u001b[1X\r\n\u001b[38;5;252m   \u001b[39m│   \u001b[38;5;70m\u001b[1m1 agent session still\u001b(B\u001b[m   │\u001b[38;5;252m   \u001b[39m\u001b[1X\r\n\u001b[38;5;252m   \u001b[39m│          \u001b[38;5;70m\u001b[1mrunning.\u001b(B\u001b[m         │\u001b[38;5;252m   \u001b[39m\u001b[1X\r\n\u001b[38;5;252m   \u001b[39m│                           │\u001b[38;5;252m   \u001b[39m\u001b[1X\r\n\u001b[38;5;252m   \u001b[39m│ \u001b[38;5;220m\u001b[1my / ↵\u001b(B\u001b[m = quit and kill all │\u001b[38;5;252m   \u001b[39m\u001b[1X\r\n\u001b[38;5;252m   \u001b[39m│          sessions         │\u001b[38;5;252m   \u001b[39m\u001b[1X\r\n\u001b[38;5;252m   \u001b[39m│    \u001b[38;5;220m\u001b[1ms\u001b(B\u001b[m = soft quit (keep    │\u001b[38;5;252m   \u001b[39m\u001b[1X\r\n\u001b[38;5;252m   \u001b[39m│      sessions alive)      │\u001b[38;5;252m   \u001b[39m\u001b[1X\r\n\u001b[38;5;252m   \u001b[39m│      \u001b[38;5;220m\u001b[1mn / Esc\u001b(B\u001b[m = cancel     │\u001b[38;5;252m   \u001b[39m\u001b[1X\r\n\u001b[38;5;252m   \u001b[39m└───────────────────────────┘\u001b[38;5;252m   \u001b[39m\u001b[1X"]
