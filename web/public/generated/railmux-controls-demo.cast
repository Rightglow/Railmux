1b[1X\u001b[38;5;147m\u001b[35;38H❯\u001b[39m \u001b[69X\u001b[38;5;239m\u001b[36;38H──────────────────────────────────────────────────────────────────────\u001b[39m\u001b[1X\u001b[38;5;244m\u001b[37;38H  ⏵⏵ normal mode · shift+tab to cycle · ← for agents\u001b[39m\u001b[19X\u001b[1;110H\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n                          \u001b[38;5;70m\u001b[1mRAILMUX  ·  PANE 2\u001b(B\u001b[m\u001b[K\u001b[18;110H                        \u001b[37m\u001b[1mReady for anothe"]
