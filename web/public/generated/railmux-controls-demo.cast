n agent\u001b[39m\u001b[8X\u001b[38;5;252m\u001b[17;38H  viewport scrolls \u001b[38;5;110m_HistoryViewport.offset\u001b[38;5;252m and returns HistoryAction\u001b[39m\u001b[3X\u001b[38;5;252m\u001b[18;38H  with render_history=\u001b[38;5;179mTrue\u001b[38;5;252m and forwarded_input=\u001b[38;5;179mb\"\"\u001b[38;5;252m — no upstream\u001b[39m\u001b[7X\u001b[38;5;252m\u001b[19;38H  input.\u001b[39m\u001b[63X\u001b[38;5;252m\u001b[20;38H  3. apply_history_action only sends upstream when\u001b[39m\u001b[21X\u001b[38;5;252m\u001b[21;38H  \u001b[38;5;110maction.forwarded_input\u001b[38;5;252m is set; empty means nothing reaches tmux. The\u001b[39m\u001b[1X\u001b[38;5;252m\u001b[22;38H  overlay is painted client-side via \u001b[38;5;110msurface.paint_overlays\u001b[38;5;252m.\u001b[39m\u001b[11X\u001b[38;5;252m\u001b[23;38H  4. This is a fast-client history overlay over bounded snapshots, not\u001b[39m\u001b[1X\u001b[38;5;252m\u001b[24;38H  tmux copy-mode; the implementation notes stock tmux WheelUpPane\u001b[39m\u001b[6X\u001b[38;5;252m\u001b[25;38H  would enter copy-mode, which is deliberately avoided.\u001b[39m\u001b[16X\u001b[38;5;252m\u001b[26;38H  Focused test: \u001b[38;5;114mtests/test_fast_full_window.py::test_local_history_rou\u001b[39m\u001b[1X\u001b[38;5;252m\u001b[27;38H  tes_sidebar_immediately_and_owns_agent_wheel asserts\u001b[39m\u001b[17X\u001b[38;5;252m\u001b[28;38H  \u001b[38;5;110magent_action.forwarded_input\u001b[38;5;252m \u001b[38;5;179m==\u001b[38;5;252m \u001b[38;5;179mb\"\"\u001b[38;5;252m.\u001b[39m\u001b[33X\u001b[38;5;252m\u001b[29;38H  Suggested addition: assert \u001b[38;5;110magent_action.render_history\u001b[38;5;252m is \u001b[38;5;179mTrue\u001b[38;5;252m,\u001b[39m\u001b[6X\u001b[38;5;252m\u001b[30;38H  proving the overlay rendered rather than merely dropping the event.\u001b[39m\u001b[2X\u001b[31;38H\u001b[71X\n\u001b[71X\n\u001b[71X\u001b[38;5;239m\n──────────────────────────────────────────────────────────────────────\u001b[39m\u001