39m\u001b[K\u001b[38;5;252m\u001b[18;55H  Focused test: tests/test_fast_full_window.py::test_local_history_routes_sidebar_immediately_and_owns_agent_wheel asserts\u001b[39m\u001b[K\u001b[38;5;252m\u001b[19;55H  agent_action.forwarded_input == b\"\".\u001b[39m\u001b[K\u001b[38;5;252m\u001b[20;55H  Suggested addition: assert agent_action.render_history is True, proving the overlay rendered rather than merely dropping\u001b[39m\u001b[K\u001b[38;5;252m\u001b[21;55H  the event.\u001b[39m\u001b[K\u001b[22;55H\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\u001b[38;5;239m\n─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\u001b[K\u001b[38;5;147m\u001b[35;55H❯\u001b[39m \u001b[K\u001b[38;5;239m\u001b[36;55H──────────────────────────────────────────────────────────────────"]
