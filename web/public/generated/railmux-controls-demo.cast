[6.627022, "o", "\u001b[H\u001b[38;5;70m\u001b[1m─ PROJECTS ──────────────────── 1 ─\u001b(B\u001b[m\u001b[1X\r\n\u001b[30m\u001b[1m+ New project                      \u001b(B\u001b[m\u001b[1X\r\n\u001b[30m\u001b[1m───────────────────────────────────\u001b(B\u001b[m\u001b[1X\r\n\u001b[38;5;231m\u001b[48;5;22m\u001b[1m  railmux                        1 \u001b(B\u001b[m\u001b[1X\r\n\u001b[38;5;252m                                   \u001b[39m\u001b[1X\r\n\u001b[38;5;252m                                   \u001b[39m\u001b[1X\r\n\u001b[38;5;252m                                   \u001b[39m\u001b[1X\r\n\u001b[38;5;252m                                   \u001b[39m\u001b[1X\r\n\u001b[38;5;70m\u001b[1m─ \u001b[30mSESSIONS (railmux)\u001b[38;5;70m ──────────\u001b[30m 1 \u001b[38;5;70m─\u001b(B\u001b[m\u001b[1X\r\n\u001b[30m\u001b[1m+ New session                      \u001b(B\u001b[m\u001b[1X\r\n\u001b[30m\u001b[1m───────────────────────────────────\u001b(B\u001b[m\u001b[1X\r\n\u001b[30m\u001b[1m◦\u001b(B\u001b[m\u001b[38;5;252m Explain workspace layout         \u001b[39m\u001b[1X\r\n\u001b[38;5;244m  2d ago · 2 msg · 0 tok\u001b[38;5;252m           \u001b[39m\u001b[1X\r\n\u001b[38;5;252m                                   \u001b[39m\u001b[1X\r\n\u001b[38;5;252m                                   \u001b[39m\u001b[1X\r\n\u001b[38;5;252m                                   \u001b[39m\u001b[1X\r\n\u001b[38;5;252m                                   \u001b[39m\u001b[1X\r\n\u001b[38;5;252m                                   \u001b[39m\u001b[1X\r\n\u001b[38;5;252m                                   \u001b[39m\u001b[1X\r\n\u001b[38;5;252m                                   \u001b[39m\u001b[1X\r\n\u001b[38;5;252m                                   \u001b[39m\u001b[1X\r\n\u001b[38;5;252m                                   \u001b[39m\u001b[1X\r\n\u001b[38;5;252m                                   \u001b[39m\u001b[1X\r\n\u001b[38;5;252m                                   \u001b[39m\u001b[1X\r\n\u00