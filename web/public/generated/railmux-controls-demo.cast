9m\u001b[K\u001b[38;5;252m\u001b[16;55H  4. This is a fast-client history overlay over bounded snapshots, not tmux copy-mode; the implementation notes stock tmux\u001b[39m\u001b[K\u001b[38;5;252m\u001b[17;55H  WheelUpPane would enter copy-mode, which is deliberately avoided.\u001b[39m\u001b[K\u001b[38;5;252m\u001b[18;55H  Focused test: \u001b[38;5;114mtests/test_fast_display_history.py::test_local_history_routes_sidebar_immediately_and_owns_agent_wheel\u001b[39m\u001b[K\u001b[38;5;252m\u001b[19;55H  asserts \u001b[38;5;110magent_action.forwarded_input\u001b[38;5;252m \u001b[38;5;179m==\u001b[38;5;252m \u001b[38;5;179mb\"\"\u001b[38;5;252m.\u001b[39m\u001b[K\u001b[38;5;252m\u001b[20;55H  Suggested addition: assert \u001b[38;5;110magent_action.render_history\u001b[38;5;252m is \u001b[38;5;179mTrue\u001b[38;5;252m, proving the overlay rendered rather than merely dropping\u001b[39m\u001b[K\u001b[38;5;252m\u001b[21;55H  the event.\u001b[39m\u001b[K\u001b[22;55H\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\n\u001b[K\u001b[38;5;239m\n─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\u001b[K\u001b[38;5;147m\u001b[35;55H❯\u001b[39m \u001b[K\u001b[38;5;239m\u001b[36;55H───────────────────────────────────────────────────────────────────"]
