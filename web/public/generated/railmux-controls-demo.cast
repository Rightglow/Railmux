1b[K\u001b[38;5;252m\u001b[1m\u001b[10;55H  \u001b(B\u001b[m\u001b[38;5;252mrailmux ssh — agent-pane wheel served locally, not forwarded upstream:\u001b[39m\u001b[K\u001b[38;5;252m\u001b[11;55H  1. handle_terminal_part gets the SgrMouseEvent and dispatches to \u001b[38;5;110mLocalHistoryView.wheel\u001b[38;5;252m.\u001b[39m\u001b[K\u001b[38;5;252m\u001b[12;55H  2. \u001b[38;5;110mwheel()\u001b[38;5;252m resolves the pane via _route_at; a hit on an agent viewport scrolls \u001b[38;5;110m_HistoryViewport.offset\u001b[38;5;252m and returns\u001b[39m\u001b[K\u001b[38;5;252m\u001b[13;55H  HistoryAction with render_history=\u001b[38;5;179mTrue\u001b[38;5;252m and forwarded_input=\u001b[38;5;179mb\"\"\u001b[38;5;252m — no upstream input.\u001b[39m\u001b[K\u001b[38;5;252m\u001b[14;55H  3. apply_history_action only sends upstream when \u001b[38;5;110maction.forwarded_input\u001b[38;5;252m is set; empty means nothing reaches tmux. The\u001b[39m\u001b[K\u001b[38;5;252m\u001b[15;55H  overlay is painted client-side via \u001b[38;5;110msurface.paint_overlays\u001b[38;5;252m.\u001b[39m\u001b[K\u001b[38;5;252m\u001b[16;55H  4. This is a fast-client history overlay over bounded snapshots, not tmux copy-mode; the implementation notes stock tmux\u001b[39m\u001b[K\u001b[38;5;252m\u001b[17;55H  WheelUpPane would enter copy-mode, which is deliberately avoided.\u001b[39m\u001b[K\u001b[38;5;252m\u001b[18;55H  Focused test: \u001b[38;5;114mtests/test_fast_full_window.py::test_local_history_routes_sidebar_immediately_and_owns_agent_wheel\u001b[38;5;252m asserts\u001b[39m\u001b[K\u001b[38;5;252m\u001b[19;55H  \u001b[38;5;110magent_action.forwarded_input\u001b[38;5;252m \u001b[38;5;179m==\u001b[38;5;252m \u001b[38;5;179mb\"\"\u001b[38;5;252m.\u001b[39m\u001b[K\u001b[38;5;252m\u001b[20;55H  Suggested addition: assert \u001b[38;5;110magent_action.render_history\u001b[38;5;252m is \u001b[38;5;179mTrue\u001b[38;5;252m, proving the overlay rendered rather than merely dropping\u001b[39m\u001b[K\u001