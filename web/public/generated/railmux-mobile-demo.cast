[7.694069, "o", "non-mobile\r\n  profile through presentation_for_geometry\r\n\u001b[38;5;239m─────────────────────────────────────────────\r\n\u001b[38;5;147m❯\u001b[39m \r\n\u001b[38;5;239m─────────────────────────────────────────────\r\n\u001b[38;5;244m  ⏵⏵ normal mode · shift+tab to cycle · ←\u001b[39m\r\n\u001b[36;42H\u001b[38;5;244m for agents\u001b[39m\u001b[K\u001b[1;38r\u001b[37;7H\u001b[?25l\u001b[?12l\u001b[?25h\u001b[?25l\u001b[38;5;173m\u001b[H▝▜█████▛▘  \u001b[38;5;252mOpus 5 (1M context) · API Usage Bil\u001b[38;5;173m\u001b[2;1H  ▘▘ ▝▝    \u001b[38;5;252m/demo/railmux-web-workspace-v1/proj\u001b[39m\u001b[3;1H\u001b[K\u001b[38;5;147m\r\n❯\u001b[39m \u001b[38;5;252mExplain why a 76x30 Railmux terminal uses\u001b[39m\u001b[K\u001b[38;5;252m\r\n  the compact single-page projection while\u001b[39m\u001b[K\u001b[38;5;252m\r\n  a 160x38 terminal remains in the ordinary\u001b[39m\u001b[K\u001b[38;5;252m\r\n  wide sidebar-plus-agent layout. Cite the\u001b[39m\u001b[K\u001b[38;5;252m\r\n  exact responsive-layout symbols and one\u001b[39m\u001b[K\u001b[38;5;252m\r\n  existing focused test. Suggest one\u001b[39m\u001b[K\u001b[38;5;252m\r\n  website-recorder assertion that prevents\u001b[39m\u001b[K\u001b[38;5;252m\r\n  a desktop demo from accidentally using\u001b[39m\u001b[K\u001b[38;5;252m\r\n  compact mode.\u001b[39m\u001b[K\r\n\u001b[K\u001b[38;5;147m\r\n●\u001b[39m \u001b[38;5;252m\u001b[1mVerify responsive layout gates\u001b(B\u001b[m\u001b[K\u001b[38;5;252m\u001b[1m\r\n  \u001b(B\u001b[m\u001b[38;5;110mpresentation_for_geometry()\u001b[38;5;252m selects the\u001b[39m\u001b[K\u001b[38;5;252m\r\n  projection from geometry with hysteresis.\u001b[39m\u001b[K\u001b[38;5;252m\r\n  From \u001b[38;5;110mWorkspacePresentation.WIDE\u001b[38;5;252m it enters\u001b[39m\u001b[K\u001b[38;5;252m\r\n  \u001b[38;5;179mCOMPACT\u001b[38;5;252m when either dimension is cramped:\u001b[39m\u001b[K\u001b[38;5;252m\r\n  width < COMPACT_ENTER_WIDTH (80) or height\u001b[39m\u001b[K\u001b[38;5;252m\r\n  < COMPACT_ENTER_HEIGHT (24).\u001b[39m\u001b[K\u001b[38;5;252m\r\n  76x30: width 76 < 80, so it returns \u001b[38;5;179mCOMPACT\u001b[39m\u001b[K\u001b[38;5;252m\r\n  even though 30 rows clear the height gate.\u001b[39m\u001b[K\u001b[38;5;252m\r\n  160x38: 160 ≥ 80 and 38 ≥ 24, so it stays\u001b[39m\u001b[K\u001b[38;5;252m\r\n  \u001b[38;5;179mWIDE\u001b[38;5;252m with sidebar plus agent.\u001b[39m\u001b[K\u001b[38;5;252m\r\n  COMPACT_EXIT_WIDTH/HEIGHT (84/26) only\u001b[39m\u001b[K\u001b[38;5;252m\r\n  applies once already compact.\u001b[39m\u001b[K\u001b[38;5;252m\r\n  Existing focused test: \u001b[38;5;114mtests/test_agent_wor\u001b[39m\u001b[K\u001b[38;5;252m\r\n  \u001b[38;5;110mkspace.py\u001b[38;5;252m::test_compact_presentation_uses_t\u001b[39m\u001b[K\u001b[38;5;252m\r\n  wo_dimensional_hysteresis pins both width\u001b[39m\u001b[K\u001b[38;5;252m\r\n  and height behavior.\u001b[39m\u001b[K\u001b[38;5;252m\r\n  Recorder guard: pass each non-mobile\u001b[39m\u001b[K\u001b[38;5;252m\r\n  profile through presentation_for_geometry\u001b[39m\u001b[K\u001b[38;5;239m\r\n"]
