[4.091986, "o", "\u001b[H\u001b[38;5;70m\u001b[1m─ PROJECTS ────────────────────────────── 3 ─\u001b(B\u001b[m\u001b[K\r\n\u001b[30m\u001b[1m+ New project                                \u001b(B\u001b[m\u001b[K\r\n\u001b[30m\u001b[1m─────────────────────────────────────────────\u001b(B\u001b[m\u001b[K\r\n\u001b[38;5;231m\u001b[48;5;22m\u001b[1m  railmux                                  3 \u001b(B\u001b[m\u001b[K\r\n\u001b[38;5;252m  compiler-lab                             1 \u001b[39m\u001b[K\r\n\u001b[38;5;252m  infra-tools                              1 \u001b[39m\u001b[K\r\n\u001b[38;5;252m                                             \u001b[39m\u001b[K\r\n\u001b[38;5;252m                                             \u001b[39m\u001b[K\r\n\u001b[38;5;70m\u001b[1m─ \u001b[30mSESSIONS (railmux)\u001b[38;5;70m ────────────────────\u001b[30m 3 \u001b[38;5;70m─\u001b(B\u001b[m\u001b[K\r\n\u001b[30m\u001b[1m+ New session                                \u001b(B\u001b[m\u001b[K\r\n\u001b[30m\u001b[1m─────────────────────────────────────────────\u001b(B\u001b[m\u001b[K\r\n\u001b[30m\u001b[1m◦\u001b(B\u001b[m\u001b[38;5;252m Polish SSH history                         \u001b[39m\u001b[K\r\n\u001b[38;5;244m  2d ago · 2 msg · 0 tok\u001b[38;5;252m                     \u001b[39m\u001b[K\r\n\u001b[30m\u001b[1m◦\u001b(B\u001b[m\u001b[38;5;252m Review layout policy                       \u001b[39m\u001b[K\r\n\u001b[38;5;244m  2d ago · 2 msg · 0 tok\u001b[38;5;252m                     \u001b[39m\u001b[K\r\n\u001b[30m\u001b[1m◦\u001b(B\u001b[m\u001b[38;5;252m Add mobile controls                        \u001b[39m\u001b[K\r\n\u001b[38;5;244m  2d ago · 2 msg · 0 tok\u001b[38;5;252m                     \u001b[39m\u001b[K\r\n\u001b[38;5;252m                                             \u001b[39m\u001b[K\r\n\u001b[38;5;252m                                             \u001b[39m\u001b[K\r\n\u001b[38;5;252m                                             \u001b[39m\u001b[K\r\n\u001b[38;5;252m                                             \u001b[39m\u001b[K\r\n\u001b[38;5;252m                                             \u001b[39m\u001b[K\r\n\u001b[38;5;252m                                             \u001b[39m\u001b[K\r\n\u001b[38;5;252m                                             \u001b[39m\u001b[K\r\n\u001b[38;5;252m                                             \u001b[39m\u001b[K\r\n\u001b[30m\u001b[1m─ RUNNING ─────────────────────────────── 1 ─\u001b(B\u001b[m\u001b[K\r\n\u001b[38;5;70m\u001b[48;5;237m\u001b[1m•\u001b[38;5;231m railmux/(new)                              \u001b(B\u001b[m\u001b[K\r\n\u001b[38;5;252m                                             \u001b[39m\u001b[K\r\n\u001b[38;5;252m                                             \u001b[39m\u001b[K\r\n\u001b[38;5;252m                                             \u001b[39m\u001b[K\r\n\u001b[38;5;252m                                             \u001b[39m\u001b[K\r\n\u001b[38;5;252m                                             \u001b[39m\u001b[K\r\n\u001b[38;5;252m                                             \u001b[39m\u001b[K\r\n\u001b[30m\u001b[1m─────────────────────────────────────────────\u001b(B\u001b[m\u001b[K\r\n\u001b[30m\u001b[1m↑↓ move · Tab pane · C-b Tab Target · ↵ open\u001b(B\u001b[m\u001b[K\r\n\u001b[30m\u001b[1mn new · / filter · i info · t term · F8 layout\u001b[37;1H\u001b[38;5;231m\u001b[48;5;236m?\u001b(B\u001b[m\u001b[38;5;252m\u001b[48;5;236m Help\u001b[49m\u001b[30m\u001b[1m \u001b[38;5;231m\u001b[48;5;236mq\u001b(B\u001b[m\u001b[38;5;252m\u001b[48;5;236m Quit\u001b[49m\u001b[30m\u001b[1m \u001b[38;5;231m\u001b[48;5;236mC-b d\u001b(B\u001b[m\u001b[38;5;252m\u001b[48;5;236m Detach\u001b[49m\u001b[30m\u001b[1m \u001b(B\u001b[m\u001b[38;5;231m\u001b[48;5;236m\u001b[1m+\u001b(B\u001b[m\u001b[38;5;252m\u001b[48;5;236m More\u001b[39m\u001b[49m\u001b[K"]
