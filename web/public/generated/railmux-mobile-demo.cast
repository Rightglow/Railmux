_for_geometry()\u001b[39m\u001b[K\u001b[38;5;252m\r\n  selects the projection from\u001b[39m\u001b[K\u001b[38;5;252m\r\n  geometry with hysteresis.\u001b[39m\u001b[K\u001b[38;5;252m\r\n  From\u001b[39m\u001b[K\u001b[38;5;252m\r\n  \u001b[38;5;110mWorkspacePresentation.WIDE\u001b[38;5;252m it\u001b[39m\u001b[K\u001b[38;5;252m\r\n  enters \u001b[38;5;179mCOMPACT\u001b[38;5;252m when either\u001b[39m\u001b[K\u001b[38;5;252m\r\n  dimension is cramped: width <\u001b[39m\u001b[K\u001b[38;5;252m\r\n  COMPACT_ENTER_WIDTH (80) or\u001b[39m\u001b[K\u001b[38;5;252m\r\n  height < COMPACT_ENTER_HEIGHT\u001b[39m\u001b[K\u001b[38;5;252m\r\n  (24).\u001b[39m\u001b[K\u001b[38;5;252m\r\n  76x30: width 76 < 80, so it\u001b[39m\u001b[K\u001b[38;5;252m\r\n  returns \u001b[38;5;179mCOMPACT\u001b[38;5;252m even tho"]
