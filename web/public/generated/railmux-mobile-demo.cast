001b[K\r\n\u001b[30m\u001b[1m─ RUNNING ────────────────────────────────────────────────────────────────────────────────────────── 1 ─\u001b(B\u001b[m\u001b[K\r\n\u001b[38;5;70m\u001b[48;5;237m\u001b[1m•\u001b[38;5;231m railmux/(new)                                                                                         \u001b(B\u001b[m\u001b[K\r\n\u001b[38;5;252m                                                                                                        \u001b[39m\u001b[K\r\n\u001b[38;5;252m                                                                                                        \u001b[39m\u001b[K\r\n\u001b[30m\u001b[1m────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b(B\u001b[m\u001b[K\r\n\u001b[30m\u001b[1m↑↓ move · Tab pane · C-b Tab Target · ↵ open · n new · / filter · i info · t term · F8 layout\u001b(B\u001b[m\u001b[K\r\n\u001b[30m\u001b[1mF9 fullscreen\u001b(B\u001b[m\u001b[K\r\n\u001b[38;5;231m\u001b[48;5;236m\u001b[1m?\u001b(B\u001b[m\u001b[38;5;252m\u001b[48;5;236m Help\u001b[49m\u001b[30m\u001b[1m \u001b(B\u001b[m\u001b[38;5;231m\u001b[48;5;236m\u001b[1mq\u001b(B\u001b[m\u001b[38;5;252m\u001b[48;5;236m Quit\u001b[49m\u001b[30m\u001b[1m \u001b[38;5;231m\u001b[48;5;236mC-b d\u001b(B\u001b[m\u001b[38;5;252m\u001b[48;5;236m Detach\u001b[49m\u001b[30m\u001b[1m \u001b[38;5;231m\u001b[48;5;236m+\u001b(B\u001b[m\u001b[38;5;252m\u001b[48;5;236m More\u001b[39m\u001b[49m\u001b[K"]
