1b[39m\u001b[K\u001b[38;5;252m\r\n  < COMPACT_ENTER_HEIGHT (24).\u001b[39m\u001b[K\u001b[38;5;252m\r\n  76x30: width 76 < 80, so it returns COMPACT\u001b[39m\u001b[K\u001b[38;5;252m\r\n  even though 30 rows clear the height gate.\u001b[39m\u001b[K\u001b[38;5;252m\r\n  160x38: 160 ≥ 80 and 38 ≥ 24, so it stays\u001b[39m\u001b[K\u001b[38;5;252m\r\n  WIDE with sidebar plus agent.\u001b[39m\u001b[K\u001b[38;5;252m\r\n  COMPACT_EXIT_WIDTH/HEIGHT (84/26) only\u001b[39m\u001b[K\u001b[38;5;252m\r\n  applies once already compact.\u001b[39m\u001b[K\u001b[38;5;252m\r\n  Existing focused test: tests/test_agent_wor\u001b[39m\u001b[K\u001b[38;5;252m\r\n  kspace.py::test_compact_presentation_uses_t\u001b[39m\u001b[K\u001b[38;5;252m\r\n  wo_dimensional_hysteresis pins both width\u001b[39m\u001b[K\u001b[38;5;252m\r\n  and height behavior.\u001b[39m\u001b[K\u001b[38;5;252m\r\n  Recorder guard: pass each non-mobile\u001b[39m\u001b[K\u001b[38;5;252m\r\n  profile through presentation_for_geometry\u001b[39m\u001b[K\u001b[38;5;239m\r\n─────"]
